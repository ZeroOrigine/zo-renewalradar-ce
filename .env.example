# ============================================================
# RenewalRadar CE — Environment Variables
#
# Copy this file to .env.local and fill in real values.
# Deploy MUST verify every variable below is set before build.
#
# Annotations:
#   [client-safe]  Exposed to the browser (NEXT_PUBLIC_* only).
#   [server-only]  Must NEVER be exposed to the client bundle.
# ============================================================

# ---------- Supabase (auth + database) ----------

# [client-safe] Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [client-safe] Supabase anon/public API key (RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# [server-only] Supabase service role key — bypasses RLS. Never ship to client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------- Payments proxy (checkout, billing, portal) ----------

# [server-only] Base URL of the payments proxy used by /api/checkout and /api/billing
PAYMENTS_URL=https://payments.example.com

# [server-only] Bearer token authenticating server calls to the payments proxy
PAYMENTS_PROXY_TOKEN=your-payments-proxy-token

# [server-only] Customer billing portal URL used by /api/billing/portal
PAYMENTS_PORTAL_URL=https://payments.example.com/portal

# ---------- Site / app URLs ----------

# [client-safe] Canonical public site URL (marketing pages, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [client-safe] App base URL used for post-checkout and billing return redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Cron + alert emails ----------

# [server-only] Shared secret required by /api/cron/send-alerts (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your-random-cron-secret

# [server-only] Resend API key for sending CE deadline alert emails
RESEND_API_KEY=re_your-resend-api-key

# [server-only] From address for alert emails (must be a verified sender in Resend)
ALERTS_FROM_EMAIL=alerts@yourdomain.com
